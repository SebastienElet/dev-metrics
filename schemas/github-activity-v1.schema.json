{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SebastienElet/dev-metrics/blob/main/schemas/github-activity-v1.schema.json",
  "title": "Activit\u00e9 github brute v1",
  "allOf": [
    {
      "$ref": "https://github.com/SebastienElet/dev-metrics/blob/main/schemas/activity-v1.schema.json"
    }
  ],
  "properties": {
    "source": {
      "const": "github"
    },
    "pull_requests": {
      "items": {
        "properties": {
          "source": {
            "const": "github"
          },
          "repository": {
            "$ref": "#/$defs/repository"
          }
        }
      }
    },
    "reviews_given": {
      "items": {
        "properties": {
          "source": {
            "const": "github"
          },
          "repository": {
            "$ref": "#/$defs/repository"
          }
        }
      }
    },
    "reviews_received": {
      "items": {
        "properties": {
          "source": {
            "const": "github"
          },
          "repository": {
            "$ref": "#/$defs/repository"
          }
        }
      }
    },
    "comments": {
      "items": {
        "properties": {
          "source": {
            "const": "github"
          },
          "repository": {
            "$ref": "#/$defs/repository"
          }
        }
      }
    },
    "commits": {
      "items": {
        "properties": {
          "source": {
            "const": "github"
          },
          "repository": {
            "$ref": "#/$defs/repository"
          }
        }
      }
    }
  },
  "$defs": {
    "repository": {
      "type": "string",
      "pattern": "^[A-Za-z0-9-]+/[A-Za-z0-9_.-]+$"
    }
  }
}
